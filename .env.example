# Neon (provided by the Vercel <-> Neon integration)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Auth (NextAuth.js + Google OAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated emails that are granted admin on sign-in
ADMIN_EMAILS=you@example.com

# Optional: magic-link e-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM=HomeOps <login@yourdomain.com>

# Optional: file storage (Vercel Blob) and receipt OCR (Anthropic)
BLOB_READ_WRITE_TOKEN=
ANTHROPIC_API_KEY=
