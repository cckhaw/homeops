# Neon (provided by the Vercel <-> Neon integration)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Auth (NextAuth.js). Google is optional; e-mail magic link needs RESEND_API_KEY
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated emails that are granted admin on sign-in
ADMIN_EMAILS=you@example.com

# Optional: magic-link e-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM=HomeOps <login@yourdomain.com>

# Optional: donations ("Buy me a coffee"). Use a restricted Stripe key with Checkout Sessions: write.
STRIPE_SECRET_KEY=
# STRIPE_CURRENCY=usd
# Alternative to the key: a hosted Stripe Payment Link (https://buy.stripe.com/...)
DONATE_URL=

# Optional: file storage (Vercel Blob) and receipt OCR (Anthropic)
BLOB_READ_WRITE_TOKEN=
ANTHROPIC_API_KEY=

# E-mail (Resend) is REQUIRED for: confirming new accounts, forgot-password and reminder e-mails.
#   RESEND_API_KEY / EMAIL_FROM are listed above.
# Daily reminder cron (Vercel sends this as "Authorization: Bearer <value>")
CRON_SECRET=

# File storage: connecting a Vercel Blob store adds BLOB_STORE_ID automatically (or set BLOB_READ_WRITE_TOKEN).
# Optional: HEALTH_KEY lets you call GET /api/health/storage with header x-health-key (admins can call it signed in).
HEALTH_KEY=
